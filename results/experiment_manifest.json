{
  "manifest_version": "1.0",
  "created_utc": "2026-09-27T21:24:34.745499+00:00",
  "study": {
    "working_title": "Evaluating Frequency-Based Tokenization in Low-Resource African Languages",
    "primary_question": "Does lower subword fragmentation necessarily imply better held-out language modeling performance under a fixed token-level training budget?",
    "languages": [
      "Yoruba",
      "Luganda",
      "Swahili"
    ],
    "dataset_source": "MasakhaNER CoNLL corpora reconstructed as whitespace-separated sentence text",
    "primary_comparison": "SentencePiece BPE versus SentencePiece Unigram",
    "primary_metric": "bits_per_character",
    "secondary_metric": "bits_per_byte"
  },
  "protocol": {
    "seeds": [
      13,
      37,
      73
    ],
    "main_vocab_size": 1000,
    "yoruba_vocab_ablation": [
      500,
      1000,
      2000
    ],
    "training": {
      "steps": 1000,
      "sequence_length_tokens": 128,
      "batch_size": 16,
      "gradient_accumulation": 2,
      "learning_rate": 0.0003,
      "token_prediction_positions_per_run": 4096000,
      "comparison_budget_description": "Same optimizer-step and token-position budget within each tokenizer comparison.",
      "not_claimed": [
        "identical number of epochs",
        "identical character exposure",
        "bitwise deterministic CUDA execution"
      ]
    },
    "model": {
      "type": "decoder-style causal Transformer implemented with TransformerEncoder causal masking",
      "d_model": 256,
      "n_heads": 4,
      "n_layers": 4,
      "d_ff": 1024,
      "dropout": 0.1,
      "weight_tying": "input token embedding tied to output projection"
    },
    "tokenization": {
      "library": "SentencePiece",
      "algorithms": [
        "BPE",
        "Unigram"
      ],
      "character_coverage": 1.0,
      "normalizer": "nmt_nfkc"
    },
    "evaluation": {
      "script": "src/evaluate_lm_v2.py",
      "held_out_primary_metric": "BPC",
      "held_out_secondary_metric": "BPB",
      "validation_used_before_final_test": true
    }
  },
